{
  "id": "section.capabilities.grid",
  "type": "section",
  "category": "content",
  "description": "Numbered capability list, some entries opening an image modal. Present on /ruv, /safe, /consolidate, /waitlist (waitlist variant has its own simpler component.capability-card without modal support — see sections/waitlist-capabilities.json).",
  "measuredFrom": "src/components/shared/Capabilities.jsx",
